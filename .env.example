# ---- copy to apps/web/.env.local for local dev; set the same keys in Vercel ----
APP_URL=http://localhost:3000

# Supabase Postgres. DATABASE_URL = Supavisor transaction pooler (port 6543) as role ai_news_app.
# DATABASE_DIRECT_URL = session/direct connection as postgres, used only by migrations.
DATABASE_URL=postgres://ai_news_app:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Better Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Google OAuth client (Internal, suzu.group org). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=suzu.group
# First admin(s); applied on first sign-in only
ADMIN_EMAILS=

# Inngest (cloud keys; locally run `pnpm --filter web inngest:dev` and set INNGEST_DEV=1)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# Cloudflare R2 (S3 API token scoped to the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-news
# Cloudflare API token (R2 lifecycle, Browser Rendering)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AWS (IAM user from `pnpm --filter @ai-news/video lambda:policies` + lambda:InvokeFunction on ai-news-media)
AWS_REGION=ap-southeast-1
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
MEDIA_LAMBDA_FUNCTION_NAME=ai-news-media
# Optional: self-hosted web-video API (packages/media-lambda/build-nas.sh) on an office/home line, because YouTube blocks AWS IPs
WEB_VIDEO_API_URL=
WEB_VIDEO_API_TOKEN=

# Google Cloud service account JSON (TTS, STT, Veo/Imagen) as a single line
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional: direct Anthropic key for local dev; production reads it from Vault via /admin/integrations
ANTHROPIC_API_KEY=
