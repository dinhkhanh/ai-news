{
  "rules": [
    {
      "id": "editor-uploads",
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://ai-news.vercel.app",
          "https://*.vercel.app",
          "https://suzu.net",
          "https://www.suzu.net"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["content-type", "content-length"]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
