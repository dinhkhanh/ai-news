{
  "name": "@ai-news/video",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compositions": "./src/compositions/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:local": "remotion render src/index.ts TestCard out/test-card.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lambda:policies": "remotion lambda policies user && remotion lambda policies role",
    "lambda:deploy": "NODE_PATH=./node_modules tsx --env-file-if-exists=../../apps/web/.env.local scripts/deploy.ts",
    "lambda:quotas": "remotion lambda quotas"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.525",
    "@remotion/cli": "4.0.525",
    "@remotion/google-fonts": "4.0.525",
    "@remotion/lambda": "4.0.525",
    "@remotion/player": "4.0.525",
    "@remotion/streaming": "4.0.525",
    "@remotion/zod-types": "4.0.525",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.525",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5"
  }
}
